# Shared/local values. Copy to .env files and fill only local, non-committed values.

# PostgreSQL / Docker Compose (the Compose stack is added in task 1.4)
POSTGRES_DB=promotions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Laravel backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=promotions
DB_USERNAME=postgres
DB_PASSWORD=
FRONTEND_URL=http://localhost:5173

# React/Vite frontend
VITE_API_URL=http://localhost:8000/api